diff --git a/_convert_hf_to_repo.py b/_convert_hf_to_repo.py
new file mode 100644
index 0000000..98b9e7c
--- /dev/null
+++ b/_convert_hf_to_repo.py
@@ -0,0 +1,66 @@
+"""Convert HF DINOv3 safetensors -> DINOv3 repo-format .pth for continued pretraining.
+
+Generic over arch (vits16 / vitb16 / ...). Validates by comparing CLS embeddings
+of the repo model (converted) vs the HF model on the same input.
+
+  python _convert_hf_to_repo.py --hub dinov3_vits16 --hf-dir <dir> --out <path>
+"""
+import argparse
+import sys
+sys.path.insert(0, ".")
+import torch
+from safetensors.torch import load_file
+from transformers import AutoModel
+
+
+def convert(hub, hf_dir, out):
+    repo_model = torch.hub.load(".", hub, source="local", pretrained=False).eval()
+    repo = repo_model.state_dict()
+    hf = load_file(f"{hf_dir}/model.safetensors")
+    o = {k: v.clone() for k, v in repo.items()}
+
+    o["cls_token"] = hf["embeddings.cls_token"]
+    o["storage_tokens"] = hf["embeddings.register_tokens"]
+    o["mask_token"] = hf["embeddings.mask_token"].reshape(repo["mask_token"].shape)
+    o["patch_embed.proj.weight"] = hf["embeddings.patch_embeddings.weight"]
+    o["patch_embed.proj.bias"] = hf["embeddings.patch_embeddings.bias"]
+    o["norm.weight"] = hf["norm.weight"]
+    o["norm.bias"] = hf["norm.bias"]
+
+    n = len({k.split(".")[1] for k in repo if k.startswith("blocks.")})
+    for i in range(n):
+        R, H = f"blocks.{i}.", f"layer.{i}."
+        o[R + "norm1.weight"] = hf[H + "norm1.weight"]; o[R + "norm1.bias"] = hf[H + "norm1.bias"]
+        o[R + "norm2.weight"] = hf[H + "norm2.weight"]; o[R + "norm2.bias"] = hf[H + "norm2.bias"]
+        qw, kw, vw = (hf[H + f"attention.{p}_proj.weight"] for p in ("q", "k", "v"))
+        o[R + "attn.qkv.weight"] = torch.cat([qw, kw, vw], 0)
+        qb, vb = hf[H + "attention.q_proj.bias"], hf[H + "attention.v_proj.bias"]
+        o[R + "attn.qkv.bias"] = torch.cat([qb, torch.zeros_like(qb), vb], 0)
+        o[R + "attn.proj.weight"] = hf[H + "attention.o_proj.weight"]; o[R + "attn.proj.bias"] = hf[H + "attention.o_proj.bias"]
+        o[R + "ls1.gamma"] = hf[H + "layer_scale1.lambda1"]; o[R + "ls2.gamma"] = hf[H + "layer_scale2.lambda1"]
+        o[R + "mlp.fc1.weight"] = hf[H + "mlp.up_proj.weight"]; o[R + "mlp.fc1.bias"] = hf[H + "mlp.up_proj.bias"]
+        o[R + "mlp.fc2.weight"] = hf[H + "mlp.down_proj.weight"]; o[R + "mlp.fc2.bias"] = hf[H + "mlp.down_proj.bias"]
+
+    repo_model.load_state_dict(o, strict=True)
+    hf_model = AutoModel.from_pretrained(hf_dir).eval()
+    torch.manual_seed(0)
+    x = torch.randn(2, 3, 224, 224)
+    with torch.no_grad():
+        feats = repo_model.forward_features(x)
+        rc = feats["x_norm_clstoken"] if isinstance(feats, dict) else feats
+        hc = hf_model(x).last_hidden_state[:, 0]
+    cos = torch.nn.functional.cosine_similarity(rc, hc, dim=-1)
+    print(f"{hub}: cosine(repo,hf)={cos.tolist()}")
+    if cos.min() > 0.98:
+        torch.save(o, out); print("VALID -> saved", out)
+    else:
+        print("MISMATCH -- not saving")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--hub", default="dinov3_vits16")
+    ap.add_argument("--hf-dir", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    convert(a.hub, a.hf_dir, a.out)
diff --git a/_extract_dapt_backbone_param.py b/_extract_dapt_backbone_param.py
new file mode 100644
index 0000000..07b0493
--- /dev/null
+++ b/_extract_dapt_backbone_param.py
@@ -0,0 +1,30 @@
+"""Parameterized version of _extract_dapt_backbone.py (from patches/dinov3_dapt.patch)
+-- extracts the TEACHER backbone (EMA'd, the usual choice for downstream eval per
+DINO/DINOv2/DINOv3 papers) from an official-trainer DCP checkpoint directory into
+a plain state_dict .pth, directly loadable by the benchmark repo's
+DINOv3FPN(which="dapt") via DINOV3_DAPT_B_WEIGHTS (no grayscale/fold conversion
+needed -- this checkpoint is already standard 3-channel architecture).
+
+  python _extract_dapt_backbone_param.py --ckpt <dir>/ckpt/2999 --out <path>.pth
+"""
+import argparse
+import torch
+from torch.distributed.checkpoint.format_utils import dcp_to_torch_save
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--ckpt", required=True)
+ap.add_argument("--out", required=True)
+ap.add_argument("--tmp", default="/tmp/_extract_full.pth")
+a = ap.parse_args()
+
+dcp_to_torch_save(a.ckpt, a.tmp)
+sd = torch.load(a.tmp, map_location="cpu", weights_only=False)
+model_sd = sd["model"] if isinstance(sd, dict) and "model" in sd else sd
+
+prefixes = sorted({k.split(".backbone.")[0] + ".backbone." for k in model_sd if ".backbone." in k})
+print("backbone prefixes found:", prefixes)
+pref = "teacher.backbone." if any(p == "teacher.backbone." for p in prefixes) else prefixes[0]
+bb = {k[len(pref):]: v for k, v in model_sd.items() if k.startswith(pref)}
+print(f"using prefix '{pref}' -> {len(bb)} backbone tensors; sample: {list(bb)[:5]}")
+torch.save(bb, a.out)
+print("saved DAPT backbone ->", a.out)
