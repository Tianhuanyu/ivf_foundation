@@ -0,0 +1,140 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# CropSampler: the three-arm abstraction for E1 (uniform / content / motion).
+# See IVF_FOUNDATION_PATENT_PLAN.md §2 for the rationale — in short: this
+# project already had a non-random, content-driven crop sampler
+# (ContentCropSampler, ported from structure_score.py) before the motion-guided
+# one existed, and content-driven proposal heads are prior art the patent's
+# claims need to be distinguished from. So E1 is a THREE-arm comparison, not
+# two, and all three MUST share every mechanic except the score map itself
+# (temperature softmax, sliding-window-max candidate scoring, sequential-
+# suppression sampling, boundary padding) — otherwise a difference between arms
+# could be an artifact of the harness rather than of what the score measures,
+# which would be fatal to both the ablation's internal validity and to any
+# claim of a technical effect in the patent.
+#
+# Usage: build_crop_sampler(name, temperature=...) -> CropSampler, then
+# augmentations.py calls sampler.sample(image, n_crops, size, meta) once per
+# image (meta currently only carries motion_energy_path, for the motion arm).
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import Protocol
+
+import numpy as np
+from PIL import Image as PILImage
+
+from dinov3.data.adaptive_crop import (
+    content_score,
+    crop_at_positions,
+    pad_if_needed,
+    sample_positions_from_score,
+    time_limit,
+    uniform_positions,
+)
+
+logger = logging.getLogger("dinov3")
+
+CROP_SAMPLERS = ("uniform", "content", "motion")
+
+
+class CropSampler(Protocol):
+    def sample(self, image: "PILImage.Image", n: int, size: int, meta: dict):
+        """Returns (crops, positions): n PIL crops of (size,size) from image,
+        and their (top,left) positions in that (possibly pad_if_needed'd)
+        image. meta carries any per-sample side info a given sampler needs
+        (e.g. motion_energy_path). Positions are returned (not just crops) so
+        callers (e.g. augmentations.py's ibot_local masking) can pull the
+        SAME spatial region out of a co-registered signal (the motion-energy
+        map) for a chosen crop, without re-deriving where it came from."""
+        ...
+
+
+class UniformCropSampler:
+    """Byte-for-byte the pre-refactor local_crops_native=True behavior: plain
+    torchvision RandomCrop, pad_if_needed=True. MUST stay behaviorally identical
+    to that — it's the acceptance test for the whole CropSampler refactor (see
+    plan §6 W0: "loss curve identical to pre-refactor"). Deliberately left
+    UNCHANGED (not reimplemented to also recover positions, unlike the other two
+    arms below) to keep zero risk to that already-validated property; returns
+    positions=None, so ibot_local masking (dinov3/data/masking.py) just falls
+    back to plain (non-saliency-guided) random local masking for this arm --
+    same graceful-degradation philosophy used everywhere else in this module."""
+
+    def sample(self, image, n, size, meta):
+        from torchvision.transforms import v2
+        cropper = v2.RandomCrop(size, pad_if_needed=True)
+        return [cropper(image) for _ in range(n)], None
+
+
+class ContentCropSampler:
+    """Structure-tensor / top-hat content score (structure_score.py port) —
+    the pre-existing adaptive_crop.py behavior, now expressed via the shared
+    CropSampler interface. Same hard-timeout + uniform fallback as before."""
+
+    def __init__(self, temperature: float = 0.3):
+        self.temperature = temperature
+
+    def sample(self, image, n, size, meta):
+        image = pad_if_needed(image, size)
+        try:
+            with time_limit():
+                gray = np.array(image.convert("L"))
+                score = content_score(gray)
+                chosen = sample_positions_from_score(score, size, n, self.temperature)
+        except Exception as e:
+            logger.warning(f"[crop_sampler:content] scoring failed/timed out ({e}); "
+                            f"falling back to uniform random crop for this image")
+            chosen = uniform_positions(image, size, n)
+        return crop_at_positions(image, size, chosen), chosen
+
+
+class MotionCropSampler:
+    """Frame-difference motion-energy score (see scripts/12_motion_energy.py,
+    precomputed at extraction time — NOT at train time, which would stall the
+    single-GPU dataloader). meta['motion_energy_path'] must point at the
+    sidecar <frame>.me.png (grayscale, short side 96) for this image; if it's
+    missing/unreadable, falls back to uniform (same philosophy as
+    ContentCropSampler's fallback — a missing/bad motion map should never hang
+    or crash the run, just degrade to the uniform arm for that one image)."""
+
+    def __init__(self, temperature: float = 0.3):
+        self.temperature = temperature
+
+    def sample(self, image, n, size, meta):
+        me_path = meta.get("motion_energy_path")
+        image = pad_if_needed(image, size)
+        try:
+            if not me_path or not os.path.exists(me_path):
+                raise FileNotFoundError(f"no motion-energy map: {me_path}")
+            with time_limit():
+                w, h = image.size
+                me = PILImage.open(me_path).convert("L").resize((w, h), PILImage.BILINEAR)
+                score = np.asarray(me, dtype=np.float32)
+                # Match content_score's own convention (max-normalized to [0,1]) --
+                # the saved sidecar is an arbitrarily-scaled uint8 PNG, and
+                # self.temperature is calibrated against a [0,1] score; feeding it
+                # raw 0-255 values made softmax(score/temperature) nearly a hard
+                # argmax, breaking E1's "same sampling mechanic, only the score map
+                # differs" requirement (see module docstring).
+                denom = score.max()
+                if denom > 1e-6:
+                    score = score / denom
+                chosen = sample_positions_from_score(score, size, n, self.temperature)
+        except Exception as e:
+            logger.warning(f"[crop_sampler:motion] unavailable/failed ({e}); "
+                            f"falling back to uniform random crop for this image")
+            chosen = uniform_positions(image, size, n)
+        return crop_at_positions(image, size, chosen), chosen
+
+
+def build_crop_sampler(name: str, temperature: float = 0.3) -> CropSampler:
+    if name == "uniform":
+        return UniformCropSampler()
+    if name == "content":
+        return ContentCropSampler(temperature=temperature)
+    if name == "motion":
+        return MotionCropSampler(temperature=temperature)
+    raise ValueError(f"unknown crop sampler '{name}', expected one of {CROP_SAMPLERS}")
