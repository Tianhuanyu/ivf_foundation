index 0000000..4d2dd58
--- /dev/null
+++ b/dinov3/data/adaptive_crop.py
@@ -0,0 +1,185 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# Shared low-level primitives for content-adaptive local-crop position sampling:
+# scoring (content_score) and sequential-suppression sampling given ANY score map
+# (sample_positions_from_score). See crop_sampler.py for the CropSampler protocol
+# that wraps these into the uniform/content/motion arms used by --crop-sampler.
+#
+# Self-contained port of domain_transfer/scripts/structure_score.py (see that
+# file for the full design writeup/citations) — duplicated here rather than
+# imported cross-repo so this patched dinov3 checkout has no dependency on the
+# sibling project's path.
+#
+# `sample_positions_from_score` is deliberately the SAME function for both the
+# content arm (score = structure-tensor/top-hat) and the motion arm (score =
+# frame-difference energy, see 12_motion_energy.py) — the E1 ablation's internal
+# validity depends on temperature, boundary handling and overlap-suppression
+# being byte-identical across arms, with the score map as the ONLY thing that
+# differs (see IVF_FOUNDATION_PATENT_PLAN.md §2).
+#
+# Hard-timeout + exception fallback: a corrupted/pathological image should
+# degrade to a uniform random crop, never hang or crash the DataLoader worker
+# (a real GCP incident: some malformed JPEGs cause libjpeg-level hangs that a
+# plain try/except cannot catch since no exception is ever raised).
+
+from __future__ import annotations
+
+import logging
+import signal
+
+import cv2
+import numpy as np
+import torch
+from PIL import ImageOps
+from torchvision.transforms import functional as TF
+
+cv2.setNumThreads(0)  # avoid the classic cv2-internal-threads + fork deadlock
+
+logger = logging.getLogger("dinov3")
+
+TIMEOUT_SEC = 10
+
+
+class ScoringTimeout(Exception):
+    pass
+
+
+def _alarm_handler(signum, frame):
+    raise ScoringTimeout(f"exceeded {TIMEOUT_SEC}s")
+
+
+class time_limit:
+    def __enter__(self):
+        signal.signal(signal.SIGALRM, _alarm_handler)
+        signal.alarm(TIMEOUT_SEC)
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        signal.alarm(0)
+        return False
+
+
+def content_score(gray_u8, tophat_scales=(5, 9, 17), st_sigma=2.0):
+    """Multi-scale morphological top-hat/black-hat ("is this region separable
+    from its neighborhood") x structure-tensor anisotropy ("is it a thin 1D
+    structure, not a 2D blob") -> per-pixel score map, normalized to [0,1]."""
+    img = gray_u8.astype(np.float32)
+    tophat = np.zeros_like(img)
+    for k in tophat_scales:
+        se = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k, k))
+        wth = cv2.morphologyEx(gray_u8, cv2.MORPH_TOPHAT, se).astype(np.float32)
+        bth = cv2.morphologyEx(gray_u8, cv2.MORPH_BLACKHAT, se).astype(np.float32)
+        tophat = np.maximum(tophat, np.maximum(wth, bth))
+
+    gx = cv2.Sobel(img, cv2.CV_32F, 1, 0, ksize=3)
+    gy = cv2.Sobel(img, cv2.CV_32F, 0, 1, ksize=3)
+    Ixx = cv2.GaussianBlur(gx * gx, (0, 0), st_sigma)
+    Iyy = cv2.GaussianBlur(gy * gy, (0, 0), st_sigma)
+    Ixy = cv2.GaussianBlur(gx * gy, (0, 0), st_sigma)
+    tr = Ixx + Iyy
+    disc = np.sqrt(np.maximum(((Ixx - Iyy) / 2.0) ** 2 + Ixy ** 2, 0.0))
+    lam_max = tr / 2.0 + disc
+    lam_min = tr / 2.0 - disc
+    anisotropy = (lam_max - lam_min) / (lam_max + lam_min + 1e-6)
+
+    score = tophat * anisotropy
+    denom = score.max()
+    if denom > 1e-6:
+        score = score / denom
+    return score.astype(np.float32)
+
+
+def _sliding_window_max(score, size, stride):
+    H, W = score.shape
+    max_top, max_left = H - size, W - size
+    if max_top < 0 or max_left < 0:
+        return [(0, 0)], np.array([float(score.max())], dtype=np.float32)
+    dil = cv2.dilate(score, np.ones((1, size), dtype=np.uint8))
+    dil = cv2.dilate(dil, np.ones((size, 1), dtype=np.uint8))
+    half = size // 2
+    tops = list(range(0, max_top + 1, stride)) or [0]
+    lefts = list(range(0, max_left + 1, stride)) or [0]
+    cand, vals = [], []
+    for t in tops:
+        for l in lefts:
+            cy = min(t + half, H - 1)
+            cx = min(l + half, W - 1)
+            cand.append((t, l))
+            vals.append(dil[cy, cx])
+    return cand, np.asarray(vals, dtype=np.float32)
+
+
+def sample_positions_from_score(score, size, n_crops, temperature=0.3,
+                                 stride_frac=1 / 8, suppress_radius_frac=0.75):
+    """score: 2D float array (H,W), any non-negative scale (need not be [0,1]).
+    Returns n_crops (top,left) positions via sequential-suppression sampling:
+    draw one from softmax(score/temperature) over sliding-window-max candidates,
+    suppress candidates within suppress_radius of it, renormalize, repeat — so
+    the n_crops draws land on distinct hotspots (if the image has more than
+    one) rather than clustering on a single one. Falls back to allowing overlap
+    once candidate probability mass is exhausted (single dominant hotspot).
+
+    Shared by ContentCropSampler and MotionCropSampler (crop_sampler.py) — the
+    ONLY thing that should differ between those two arms is what `score` is,
+    not how positions get drawn from it.
+    """
+    stride = max(1, int(size * stride_frac))
+    cand, vals = _sliding_window_max(score, size, stride)
+
+    vals = vals - vals.max()
+    base_probs = np.exp(vals / max(temperature, 1e-3))
+    base_probs = base_probs / base_probs.sum()
+    centers = np.array([(t + size / 2.0, l + size / 2.0) for t, l in cand])
+    suppress_radius = suppress_radius_frac * size
+
+    avail = base_probs.copy()
+    chosen = []
+    for _ in range(n_crops):
+        if avail.sum() <= 1e-8:
+            avail = base_probs.copy()  # hotspots exhausted -> allow overlap
+        p = avail / avail.sum()
+        idx = np.random.choice(len(cand), p=p)
+        chosen.append(cand[idx])
+        dist = np.linalg.norm(centers - centers[idx], axis=1)
+        avail = avail * (dist > suppress_radius)
+    return chosen
+
+
+def pad_if_needed(image, size):
+    """Right/bottom zero-pad so both dims are >= size. Returns the (possibly
+    unchanged) image."""
+    w, h = image.size
+    pad_w, pad_h = max(0, size - w), max(0, size - h)
+    if pad_w or pad_h:
+        image = ImageOps.expand(image, border=(0, 0, pad_w, pad_h), fill=0)
+    return image
+
+
+def crop_at_positions(image, size, positions):
+    return [TF.crop(image, t, l, size, size) for (t, l) in positions]
+
+
+def uniform_positions(image, size, n_crops):
+    w, h = image.size
+    return [(int(torch.randint(0, max(1, h - size + 1), (1,)).item()),
+             int(torch.randint(0, max(1, w - size + 1), (1,)).item()))
+            for _ in range(n_crops)]
+
+
+def adaptive_crop_positions(image, size, n_crops, temperature=0.3,
+                             stride_frac=1 / 8, suppress_radius_frac=0.75):
+    """Back-compat wrapper (content-only) — prefer crop_sampler.ContentCropSampler
+    for new code. image: PIL image (any mode, e.g. RGB — cropping happens on the
+    original image, scoring uses a grayscale view of it). Returns n_crops PIL
+    crops of size (size,size)."""
+    image = pad_if_needed(image, size)
+    try:
+        with time_limit():
+            gray = np.array(image.convert("L"))
+            score = content_score(gray)
+            chosen = sample_positions_from_score(
+                score, size, n_crops, temperature, stride_frac, suppress_radius_frac)
+    except Exception as e:
+        logger.warning(f"[adaptive_crop] scoring failed/timed out ({e}); "
+                        f"falling back to uniform random crop for this image")
+        chosen = uniform_positions(image, size, n_crops)
+    return crop_at_positions(image, size, chosen)
