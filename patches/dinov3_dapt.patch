+def init_fsdp_backbone_from_pretrained(
+    backbone: torch.nn.Module,
+    checkpoint_path: str,
+    keys_not_sharded: List[str] | None = None,
+    process_group: dist.ProcessGroup = None,
+):
+    """Load a BARE (unsharded) backbone state_dict into an FSDP-wrapped backbone.
+
+    Used for domain-adaptive continued pretraining: initialize the student
+    backbone from a released DINOv3 backbone checkpoint (which has NO SSL heads).
+    Heads keep their fresh init. Mirrors init_fsdp_model_from_checkpoint's tensor
+    distribution but targets the backbone submodule and loads non-strict.
+    """
+    keys_not_sharded = keys_not_sharded or []
+    logger.info(f"Loading pretrained backbone weights from {checkpoint_path}")
+    chkpt = torch.load(checkpoint_path, map_location="cpu")
+    for wrap_key in ("teacher", "model", "state_dict"):
+        if isinstance(chkpt, dict) and wrap_key in chkpt and isinstance(chkpt[wrap_key], dict):
+            chkpt = chkpt[wrap_key]
+    from torch.distributed.device_mesh import DeviceMesh, init_device_mesh
+
+    if process_group is None:
+        world_mesh = init_device_mesh("cuda", mesh_shape=(dist.get_world_size(),), mesh_dim_names=("dp",))
+    else:
+        world_mesh = DeviceMesh.from_group(process_group, "cuda")
+    chkpt = {
+        key: (
+            tensor
+            if any(k in key for k in keys_not_sharded)
+            else torch.distributed.tensor.distribute_tensor(tensor, world_mesh, src_data_rank=None)
+        )
+        for key, tensor in chkpt.items()
+    }
+    msg = backbone.load_state_dict(chkpt, strict=False)
+    logger.info(f"Pretrained backbone loaded. missing={list(msg.missing_keys)} unexpected={list(msg.unexpected_keys)}")
+
+
