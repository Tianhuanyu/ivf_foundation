@@ -0,0 +1,131 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# Custom dataset for domain-adaptive continued pretraining on extracted
+# microscopy frames (an ImageFolder-style tree of *.jpg). SSL: no real labels.
+#
+# Registered in loaders as:  Frames:root=/path/to/frames_hires/train
+
+import logging
+import os
+import random
+from typing import Any
+
+import numpy as np
+from PIL import ImageFile
+
+from .extended import ExtendedVisionDataset
+
+logger = logging.getLogger("dinov3")
+
+# tolerate slightly-truncated JPGs instead of crashing the whole run
+ImageFile.LOAD_TRUNCATED_IMAGES = True
+
+_EXTS = (".jpg", ".jpeg", ".png", ".bmp")
+
+
+class Frames(ExtendedVisionDataset):
+    def __init__(
+        self,
+        *,
+        root: str,
+        extra: str = None,
+        split: str = None,
+        transforms=None,
+        transform=None,
+        target_transform=None,
+    ) -> None:
+        super().__init__(root=root, transforms=transforms,
+                         transform=transform, target_transform=target_transform)
+        self.samples = []
+        for dirpath, _, filenames in os.walk(root):
+            for fn in filenames:
+                # .me.png sidecars (scripts/12_motion_energy.py, consumed by
+                # MotionCropSampler) live in the SAME directories as the .jpg
+                # frames and end in ".png", which _EXTS also matches -- without
+                # this exclusion they get picked up as if they were training
+                # images (and, since PIL Image.filename then ends in ".me.png",
+                # MotionCropSampler's own sidecar-path lookup doubles the
+                # suffix to "....me.png.me.png" and never finds a real file).
+                if fn.lower().endswith(".me.png"):
+                    continue
+                if fn.lower().endswith(_EXTS):
+                    self.samples.append(os.path.join(dirpath, fn))
+        self.samples.sort()
+        if not self.samples:
+            raise RuntimeError(f"No images found under {root}")
+
+        # Temporal importance weighting (scripts/13_frame_weights.py) -- the
+        # crop_sampler axis (uniform/content/motion) only decides WHERE to
+        # crop within whatever frame gets picked; this is the complementary
+        # WHICH-frame-gets-picked axis. Opt-in via extra="weighted" (the
+        # `extra` param was otherwise unused) so any config that doesn't ask
+        # for it keeps exactly the old uniform-over-all-frames behavior --
+        # same fallback philosophy as crop_sampler's own missing-data path.
+        self._sample_probs = None
+        if extra == "weighted":
+            weights_path = os.path.join(root, "frame_weights.npy")
+            if not os.path.exists(weights_path):
+                logger.warning(f"extra='weighted' requested but {weights_path} "
+                                f"doesn't exist (run scripts/13_frame_weights.py first) "
+                                f"-- falling back to uniform sampling")
+            else:
+                weights = np.load(weights_path)
+                if len(weights) != len(self.samples):
+                    logger.warning(f"frame_weights.npy has {len(weights)} entries but "
+                                    f"{len(self.samples)} samples were found under {root} "
+                                    f"(sidecars generated/removed since the weights were "
+                                    f"computed?) -- falling back to uniform sampling")
+                else:
+                    self._sample_probs = weights / weights.sum()
+                    logger.info(f"loaded frame_weights.npy: temporal importance-weighted "
+                                f"sampling ENABLED ({len(weights)} frames, "
+                                f"max/median ratio={weights.max() / np.median(weights):.2f})")
+
+    def get_image_data(self, index: int) -> bytes:
+        with open(self.samples[index], "rb") as f:
+            return f.read()
+
+    def get_target(self, index: int) -> Any:
+        return 0  # SSL: dummy label
+
+    def __getitem__(self, index: int):
+        # A few extracted frames are corrupt/truncated; on any read/decode error
+        # retry with a random other sample so one bad file can't kill the run.
+        #
+        # Reimplements ExtendedVisionDataset.__getitem__ (rather than calling
+        # super()) so we can stamp `image.filename = <path>` BEFORE self.transforms
+        # runs -- MotionCropSampler (crop_sampler.py) needs the source path to
+        # find the sidecar <path>.me.png motion-energy map, and by the time
+        # super().__getitem__() would return, the transform has already run
+        # without knowing the path (PIL images decoded from bytes have no
+        # filename attribute; ExtendedVisionDataset only ever hands transforms
+        # the decoded image, never the path).
+        #
+        # Temporal importance weighting: when enabled, the incoming `index`
+        # (from dinov3/data/samplers.py's uniform-over-[0,N) infinite/epoch
+        # samplers, untouched -- see __init__) is treated only as "some call
+        # happened", then REPLACED by an independent weighted draw. This keeps
+        # every call an honest fresh sample from the target distribution
+        # (rather than a fixed index->index remap table, which would
+        # permanently strand ~37% of frames unreachable for the whole run --
+        # classic "balls into N bins" coverage loss for a single static
+        # weighted-with-replacement draw of size N).
+        if self._sample_probs is not None:
+            index = int(np.random.choice(len(self.samples), p=self._sample_probs))
+        for _ in range(20):
+            path = self.samples[index]
+            try:
+                image_data = self.get_image_data(index)
+                image = self.image_decoder(image_data).decode()
+                image.filename = path
+                target = self.get_target(index)
+                target = self.target_decoder(target).decode()
+                if self.transforms is not None:
+                    image, target = self.transforms(image, target)
+                return image, target
+            except Exception:
+                index = random.randint(0, len(self.samples) - 1)
+        raise RuntimeError("too many consecutive corrupt frames")
+
+    def __len__(self) -> int:
+        return len(self.samples)
