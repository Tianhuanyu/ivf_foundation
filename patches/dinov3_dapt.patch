+
+
+class MotionGuidedMaskingGenerator(MaskingGenerator):
+    """ibot_local's masking generator (see ssl_meta_arch.py / augmentations.py's
+    _local_crop_saliency) -- same block-wise random-shape algorithm as the base
+    MaskingGenerator (used for GLOBAL crops, untouched, zero risk to it), except
+    each candidate block's (top, left) placement is accepted/rejected based on
+    the block's mean value in a per-image saliency map, rather than accepted
+    unconditionally. direction="mask_high_saliency" biases masking TOWARD the
+    salient (e.g. high motion-energy) regions -- AttMask's (ECCV'22) "hide the
+    important stuff, force the model to predict it precisely" philosophy, which
+    is what we actually want here (learn a sharper representation of exactly
+    the fine/thin structures the resolution-bottleneck diagnosis flagged as
+    poorly encoded) as opposed to MotionMAE/V-JEPA4A's opposite convention
+    (keep salient regions visible as context, mask background) which targets
+    general scene-understanding transfer (segmentation/tracking) rather than
+    precise small-object localization. direction="mask_low_saliency" gives the
+    opposite (available for the A/B this module's docstring elsewhere calls
+    for -- don't assume the AttMask direction wins here without testing both).
+
+    saliency=None (e.g. UniformCropSampler's crops, or a missing/bad sidecar)
+    -> falls back to the exact base-class unconditional-accept behavior, i.e.
+    plain random block masking. Same graceful-degradation convention as
+    crop_sampler.py.
+    """
+
+    def __init__(self, *args, direction="mask_high_saliency", gamma=1.0, n_candidates=6, **kwargs):
+        super().__init__(*args, **kwargs)
+        assert direction in ("mask_high_saliency", "mask_low_saliency")
+        self.direction = direction
+        self.gamma = gamma
+        self.n_candidates = n_candidates
+        self._saliency = None  # set per-image via set_saliency() before each __call__
+
+    def set_saliency(self, saliency):
+        """saliency: (height, width) float array in [0,1] matching this
+        generator's own token grid (i.e. already resized to local crop's
+        patch grid by augmentations.py), or None."""
+        self._saliency = saliency
+
+    def _block_weight(self, top, left, h, w):
+        region = self._saliency[top : top + h, left : left + w]
+        m = float(region.mean())
+        if self.direction == "mask_low_saliency":
+            m = 1.0 - m
+        return m**self.gamma
+
+    def _mask(self, mask, max_mask_patches):
+        if self._saliency is None:
+            return super()._mask(mask, max_mask_patches)
+
+        delta = 0
+        for _ in range(10):
+            target_area = random.uniform(self.min_num_patches, max_mask_patches)
+            aspect_ratio = math.exp(random.uniform(*self.log_aspect_ratio))
+            h = int(round(math.sqrt(target_area * aspect_ratio)))
+            w = int(round(math.sqrt(target_area / aspect_ratio)))
+            if w >= self.width or h >= self.height:
+                continue
+
+            # Saliency-weighted placement: draw a handful of candidate (top,left)
+            # positions uniformly, then pick one weighted by _block_weight rather
+            # than accepting the first uniform draw unconditionally (what the
+            # base class does) -- cheap since the grid is tiny (e.g. 8x8).
+            candidates = [
+                (random.randint(0, self.height - h), random.randint(0, self.width - w))
+                for _ in range(self.n_candidates)
+            ]
+            weights = np.array([self._block_weight(t, l, h, w) for t, l in candidates], dtype=np.float64)
+            weights = weights + 1e-6  # keep every candidate reachable even at weight 0
+            weights /= weights.sum()
+            top, left = candidates[np.random.choice(len(candidates), p=weights)]
+
+            num_masked = mask[top : top + h, left : left + w].sum()
+            if 0 < h * w - num_masked <= max_mask_patches:
+                for i in range(top, top + h):
+                    for j in range(left, left + w):
+                        if mask[i, j] == 0:
+                            mask[i, j] = 1
+                            delta += 1
+            if delta > 0:
+                break
+        return delta
