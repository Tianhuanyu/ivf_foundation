dinov3_dapt_*_out/
dinov3_dapt_run1/
# GCP round-trip staging (uploaded/downloaded via scripts/dapt_train.sh)
gcp_outputs/
# manifests contain absolute machine-local paths -> regenerate: scripts/10_build_manifest.py
manifests/
# one-off launcher/test scaffolding some sessions drop at the root -- not meant to be maintained.
run_motion_energy*.bat
_test_*.txt
# NEVER commit -- filename strongly suggests exported credentials/env vars, unread and untouched
# on purpose; if this is real, rotate whatever's in it and delete, don't just gitignore
keydump.txt
# GCP instance's current zone (machine-local state written by scripts/dapt_train.sh)
.dapt_a100_zone

