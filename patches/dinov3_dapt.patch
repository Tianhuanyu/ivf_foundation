+  OFFICIAL_EPOCH_LENGTH: 2500       # long run: epochs*this = total iters
+  num_workers: 8
+  compile: false
+  cudagraphs: false
+  centering: sinkhorn_knopp
+  saveckp_freq: 1
+  output_dir: /mnt/d/Video/domain_transfer/dinov3_dapt_vitb_run
+checkpointing:
+  period: 2500
+  max_to_keep: 3
+student:
+  arch: vit_base
+  patch_size: 16
+  pretrained_weights: /mnt/d/Video/domain_transfer/weights/dinov3_vitb16_repo.pth
+  n_storage_tokens: 4
+  mask_k_bias: true
+  norm_layer: layernormbf16
+  layerscale: 1.0e-05
+  drop_path_rate: 0.1
+  ffn_layer: mlp
+  pos_embed_type: rope
+  pos_embed_rope_base: 100.0
+  pos_embed_rope_normalize_coords: separate
+  pos_embed_rope_rescale_coords: 2
+  pos_embed_rope_dtype: fp32
+  fp8_enabled: false
+  in_chans: 3
+teacher:
+  in_chans: 3
+optim:
+  epochs: 8                          # long run: 8 * 2500 = 20000 iters
+  warmup_epochs: 1
+  freeze_last_layer_epochs: 1
+  lr: 1.0e-04
+crops:
+  local_crops_number: 8
+  global_crops_size: 224             # coarse: resized whole-frame view
+  local_crops_size: 128             # fine: NATIVE-resolution crop (no downscale)
+  local_crops_native: true
